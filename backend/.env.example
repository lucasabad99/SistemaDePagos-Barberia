# Copiar a .env y completar. Nunca subir .env a GitHub.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/barberia
# Generar uno largo y aleatorio, distinto en cada entorno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=12h
# URL del frontend (para CORS). En local Vite usa el 5173.
CORS_ORIGIN=http://localhost:5173
